{
  "manifest_version": 3,
  "name": "Following: Instagram session sync",
  "version": "1.0.0",
  "description": "Sends your instagram.com session cookie to your local Following app, so you never have to paste it.",
  "key": "",
  "permissions": ["cookies", "storage", "alarms"],
  "host_permissions": ["https://*.instagram.com/*", "http://localhost/*", "http://127.0.0.1/*"],
  "background": { "service_worker": "background.js" },
  "action": { "default_title": "Following", "default_popup": "popup.html" }
}
