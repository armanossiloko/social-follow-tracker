# Copy to .env and adjust. docker compose reads it automatically.

# Password for the bundled Postgres (letters and digits only; it goes into a connection string).
POSTGRES_PASSWORD=change-me

# Time zone for the daily schedule (IANA name, e.g. Europe/Berlin, America/New_York).
TZ=UTC
DAILY_AT=09:00

# The report is served at http://localhost:PORT
PORT=47321

# Folder on your PC watched for instagram-*.zip exports, mounted read-only (e.g. C:/Users/you/Downloads).
EXPORTS_DIR=./imports
